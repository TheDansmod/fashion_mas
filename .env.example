# Copy to .env. Nested settings use a double underscore: SECTION__FIELD.
# Every application setting has a default in src/frag/settings.py; set only what you need.
# Pick ONE of the two presets below, then fill in the shared section at the end.
#
# AWS credentials: use a named profile or SSO (`aws configure sso`, then AWS_PROFILE=...),
# or the instance role when running on AWS. Don't put AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY in this file: static keys override the role and leak easily.
# The catalogue (images + metadata) is always read from S3, so local mode needs them too.

APP_ENV=development
# AWS_REGION=us-east-1
# AWS_PROFILE=<profile>

# ================================================================================
# Preset 1: local development (free apart from small S3/DynamoDB reads)
#   LLM on Ollama, SigLIP query embeddings against the `fashion_gen` collection,
#   SQLite checkpoints. Needs `uv sync --group siglip --group local-llm`,
#   `ollama pull qwen3.5:4b`, and Qdrant (`podman compose up -d`).
# ================================================================================
LLM__PROVIDER=ollama
# LLM__MODEL_ID=qwen3.5:4b                 # any pulled vision model; qwen3.5:4b is the tested one
# LLM__REASONING=false                     # thinking off (small models need it off for structured output)
# OLLAMA_HOST=http://localhost:11434       # read by the ollama client
EMBEDDING__BACKEND=siglip
CHECKPOINTER__BACKEND=sqlite
# CHECKPOINTER__SQLITE_PATH=data/pipeline_checkpoints.db

# ================================================================================
# Preset 2: AWS (billed per Bedrock call)
#   Claude Haiku 4.5 on Bedrock, Nova embeddings against `nova_fashion_gen`,
#   DynamoDB checkpoints. Install without the siglip group.
# ================================================================================
# LLM__PROVIDER=bedrock
# LLM__MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0   # the default for bedrock
# LLM__RATE_LIMIT_RPS=0.15                 # the default for bedrock (quota: 10 requests/minute)
# EMBEDDING__BACKEND=nova
# CHECKPOINTER__BACKEND=dynamodb
# CHECKPOINTER__DYNAMODB_TABLE=langgraph-checkpoints   # written by write_env_from_stack.sh

# ================================================================================
# Other options (either preset)
# ================================================================================
# VECTOR_DB__URL=http://localhost:6333
# TOOLS__MODE=local                        # local (in-process) | mcp (start `uv run frag mcp` first)
# TOOLS__MCP_URL=http://localhost:9000/mcp
# CHECKPOINTER__BACKEND=memory             # also: postgres, with `podman compose --profile postgres up -d`
# CHECKPOINTER__POSTGRES_DSN=postgresql://frag:frag@localhost:5432/frag
# EVALUATION__JUDGE_LLM__PROVIDER=bedrock  # judge `frag eval` with another LLM (default: the agent's)
# LOGGING__LEVEL=INFO

# ================================================================================
# Shared: AWS resources, Chainlit auth, observability
# ================================================================================
# The values below come from the CloudFormation stacks; fill them in with
#   infra/scripts/write_env_from_stack.sh --write
# (it also writes OAUTH_COGNITO_CLIENT_SECRET, which it never prints).
CATALOGUE__S3_BUCKET=frag-fashion-gen-dataset
CHAT_HISTORY__DYNAMODB_TABLE=<chainlit-table-name>
CHAT_HISTORY__S3_BUCKET=<chainlit-elements-bucket-name>
OAUTH_COGNITO_CLIENT_ID=<client-id>
OAUTH_COGNITO_CLIENT_SECRET=<client-secret>
OAUTH_COGNITO_DOMAIN=<prefix>.auth.<region>.amazoncognito.com
OAUTH_COGNITO_SCOPES="openid email profile"

# Chainlit (read by Chainlit itself)
CHAINLIT_AUTH_SECRET=<output of `uv run chainlit create-secret`>
OAUTH_PROMPT=login

# LangSmith tracing (optional; read by LangSmith itself)
LANGSMITH_TRACING=false
# LANGSMITH_PROJECT=<project>
# LANGSMITH_API_KEY=<key>
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Misc
FASTMCP_ENABLE_RICH_TRACEBACKS=false       # plain tracebacks from the MCP server
# HF_TOKEN=<token>                         # optional; for downloading the SigLIP model
