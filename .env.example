# Copy to .env. Nested settings use a double underscore: SECTION__FIELD.
# Every application setting has a default in src/frag/settings.py; only override what you need.

APP_ENV=development
# AWS_REGION=us-east-1

# --- LLM -------------------------------------------------------------------------
# LLM__PROVIDER=ollama                     # ollama (default; local, `uv sync --group local-llm`) | bedrock (billed)
# LLM__MODEL_ID=qwen3.5:4b                 # default per provider: qwen3.5:4b (ollama), Claude Haiku 4.5 (bedrock)
# LLM__RATE_LIMIT_RPS=0.8                  # requests/second; default per provider: none (ollama), 0.8 (bedrock)
# LLM__REASONING=false                     # ollama only: thinking off by default (small models need it off)
# OLLAMA_HOST=http://localhost:11434       # read by the ollama client
# Start the Ollama server with LLAMA_ARG_CACHE_RAM=0; otherwise its runner keeps up to 8 GiB of
# prompt cache in system RAM (see cleanup.md, Phase 7 notes).

# --- Embeddings / vector DB ------------------------------------------------------
# EMBEDDING__BACKEND=siglip               # siglip (local, fashion_gen; `uv sync --group siglip`) | nova (Bedrock, nova_fashion_gen; billed)
# VECTOR_DB__URL=http://localhost:6333

# --- Catalogue tools -------------------------------------------------------------
# TOOLS__MODE=local                        # local (in-process) | mcp (run `uv run mcp_server.py` first)
# TOOLS__MCP_URL=http://localhost:9000/mcp

# --- LangGraph checkpointer ------------------------------------------------------
# CHECKPOINTER__BACKEND=sqlite             # memory | sqlite | postgres | dynamodb
# CHECKPOINTER__SQLITE_PATH=data/pipeline_checkpoints.db
# CHECKPOINTER__POSTGRES_DSN=postgresql://frag:frag@localhost:5432/frag   # `podman compose --profile postgres up -d`
# CHECKPOINTER__DYNAMODB_TABLE=langgraph-checkpoints

# --- Chainlit chat history (required by the Chainlit app) ------------------------
CHAT_HISTORY__DYNAMODB_TABLE=<chainlit-table-name>
CHAT_HISTORY__S3_BUCKET=<chainlit-elements-bucket-name>

# --- Chainlit auth: AWS Cognito (read by Chainlit itself) -------------------------
CHAINLIT_AUTH_SECRET=<output of `chainlit create-secret`>
OAUTH_COGNITO_CLIENT_ID=<client-id>
OAUTH_COGNITO_CLIENT_SECRET=<client-secret>
OAUTH_COGNITO_DOMAIN=<prefix>.auth.<region>.amazoncognito.com
OAUTH_COGNITO_SCOPES="openid email profile"
OAUTH_PROMPT=login

# --- Observability (read by LangSmith itself) ------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=<project>
LANGSMITH_API_KEY=<key>
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Misc -------------------------------------------------------------------------
# FastMCP renders errors with rich, hiding frames; disable for easier debugging
FASTMCP_ENABLE_RICH_TRACEBACKS=false
# HF_TOKEN=<token>                         # optional; for downloading the SigLIP model

# AWS credentials: use `aws configure` / `aws configure sso` (or an instance role on AWS).
# Avoid static AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in this file.
