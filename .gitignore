# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tool caches and reports
.ruff_cache/
.pytest_cache/
.coverage
/reports/

# Logs
*.log
/logs/

# Local data (qdrant storage, checkpoints, temp images, token usage, ...).
# Using /** (not /) so git still traverses the folder and the negations below apply.
/data/**
# the manually curated evaluation dataset is tracked - both the directory and its
# contents must be un-ignored, since git won't descend into an ignored directory
!/data/evaluation_data/
!/data/evaluation_data/**

# Secrets - see .env.example for the expected keys
.env
.env.bak

# Chainlit: local config/translations (a production config.toml will be committed
# later), the generated chainlit.md, and the .files/ upload staging folder
.chainlit/
chainlit.md
.files/

# Generated agent graph diagram
fashion_agent_diagram.png

# don't need to track frag completion plan (that is internal only)
docs/frag_aws_completion_plan.md
